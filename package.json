{
  "name": "bitrix-tools",
  "displayName": "Bitrix Tools",
  "description": "Navigation and helpers for 1C-Bitrix development",
  "version": "0.0.1",
  "publisher": "local",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:php"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Bitrix Tools",
      "properties": {
        "bitrixTools.siteTemplate": {
          "type": "string",
          "default": "",
          "description": "Site template folder name (under local/templates or bitrix/templates) to use when resolving IncludeComponent template links. Leave empty to be prompted with a picker whenever multiple site templates match on disk."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "pretest": "npm run compile",
    "test": "node --test 'out/test/unit/**/*.test.js'"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.0"
  }
}
